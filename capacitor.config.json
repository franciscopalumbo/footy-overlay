{
  "$schema": "https://capacitorjs.com/docs/config",

  "appId": "au.com.footyoverlay.app",
  "appName": "FootyOverlay",

  "webDir": ".",

  "bundledWebRuntime": false,

  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.fanfooty.com.au",
      "*.netlify.app",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ],
    "hostname": "footyoverlay.app"
  },

  "android": {
    "buildOptions": {
      "keystorePath": "release.keystore",
      "keystoreAlias": "footyoverlay",
      "releaseType": "APK"
    },
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,

    "loggingBehavior": "none",

    "flavor": "tv"
  },

  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0d1117",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },

    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    }
  }
}
