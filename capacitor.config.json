{
  "$schema": "https://capacitorjs.com/docs/config",

  "appId": "au.com.footyoverlay.app",
  "appName": "FootyOverlay",

  "webDir": "www",

  "server": {
    "url": "https://footyoverlay.netlify.app",
    "androidScheme": "https",
    "allowNavigation": [
      "footyoverlay.netlify.app",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ]
  },

  "android": {
    "buildOptions": {
      "keystorePath": "release.keystore",
      "keystoreAlias": "footyoverlay",
      "releaseType": "APK"
    },
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "loggingBehavior": "none"
  },

  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0d1117",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
